# Copy to .env.local and fill in. Do not commit .env.local.

# Required for loading projects and for auth.
MONGODB_URI=

# Optional: set once to create the admin user on first run. Remove or leave blank after that.
# Use scripts/reset-password.js to change the password later.
INITIAL_ADMIN_PASSWORD=

# Optional: secret for signing session cookies. Set in production.
# AUTH_SECRET=
